# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Persönliche Tool-Konfiguration auf Frontend-Ebene (analog zur Wurzelregel)
frontend/.claude/
frontend/.mcp.json

# MCP-Konfiguration in JEDEM Verzeichnis ausschließen. In der Sandbox werden
# solche Dateien als /dev/null-Geräteknoten eingeblendet (nobody:nogroup); sie
# dürfen nie ins Repository geraten. Ohne führenden / greift die Regel auf allen
# Ebenen (z. B. frontend/src/.mcp.json, frontend/src/i18n/.mcp.json).
.mcp.json

# PHP
vendor/

# Hugo-Binary (wird per bin/get-hugo.sh geholt, nicht versioniert)
bin/hugo/

# Sitzungen / temporär
*.log
backend/log/*.log
backend/var/sessions/
backend/var/audit/
backend/var/audit-content/
backend/var/review/
backend/var/pagespeed/
backend/var/analyze/
backend/var/cron/
.DS_Store
node_modules/
tmp/

# Beispiel-Datenverzeichnis (in echten Installationen nicht versionieren)
daten/
site/

# Auslieferungs-Repo mit dem fertigen Produkt (eigenes Repo: hugocms-release)
hugocms-release/

# SEO-Erfolgsmessung (in echten Installationen nicht versionieren eignes Backend)
seo-success/

# Installationsspezifische Konfigurationsdateien (Vorlagen *.ini.beispiel
# bleiben versioniert, da sie nicht auf .ini enden).
*.ini
*.bak
*.ini.daten

# Anwenderspezifischer Bootstrap (Vorlage: custom.php.beispiel).
custom.php

# Der private Lizenz-Signierschlüssel darf NIEMALS ins Repository.
private.key
scripts/keygen/private.key
scripts/keygen/

# Persönliche/Umgebungs-Konfiguration im Projektwurzelverzeichnis
# (Shell-rc, Editor- und Tool-Configs wie .bashrc, .mcp.json, .idea, .vscode …).
# Führender / = nur Wurzelebene, damit .htaccess/.gitkeep in Unterordnern
# erhalten bleiben. Was ins Repo gehört, wird ausgenommen.
/.*
!/.gitignore
!/.gitmodules
!/.claude/
