; HugoCMS – Mount-Konfiguration (Vorlage)
; ===========================================================================
; HugoCMS verwaltet mehrere Webseiten. Die Mounts der aufgerufenen Webseite
; stehen in einer host-spezifischen Datei:
;
;     backend/mounts/<hash>.ini
;
; Den <hash> bildet das Backend aus Host + Endpunkt-Pfad (siehe SiteKey).
; Den exakten Dateinamen nennt die Einrichtungs-/Fehlermeldung des Clients
; oder das Hilfsskript:  scripts/site-hash.sh <host><endpunkt-pfad>
;
; Fehlt die host-spezifische Datei, gilt backend/mounts.ini als RÜCKFALL
; (mit Hinweis an den Client). Fehlt auch diese, meldet das Backend die
; Webseite als unbekannt (404). Das Format ist überall identisch.
;
; Zum Verwenden: nach backend/mounts/<hash>.ini (je Webseite) oder nach
; backend/mounts.ini (Rückfall) kopieren und anpassen.
;
; Regeln:
;   • Jede [Sektion] ist ein Mount. Der Sektionsname ist die interne ID
;     (kurz, ohne Leer- und Sonderzeichen).
;   • path        (Pflicht)  Verzeichnis des Mounts. Relative Pfade gelten
;                            relativ zu DIESER Datei. Absolute Pfade empfohlen.
;   • label       (optional) Anzeigename im Client. Standard: Sektionsname.
;   • permissions (optional) Kommaliste. Werte: read, write, upload, delete,
;                            mkdir, rename, copy, move. Fehlt sie: alle Rechte.
;   • accept      (optional) Kommaliste erlaubter Endungen (ohne Punkt).
;                            Leer oder fehlend: alle Endungen erlaubt.
;   • readonly    (optional) true = nur Lesen (überschreibt permissions).
;
; Werte mit Sonderzeichen bei Bedarf in "doppelte Anführungszeichen" setzen.
;
; Reservierte Sektion [hugo] (KEIN Mount): konfiguriert den webseiten-
; spezifischen Teil des Hugo-Aufrufs für den Veröffentlichen-Knopf des Clients
; (API-Befehl "build"). Ohne diese Sektion wird der Knopf nicht angeboten.
; Das Hugo-PROGRAMM (bin) steht zentral in der hugocms.ini — nicht hier.
;   • source      (Pflicht)  Hugo-Projektverzeichnis.
;   • destination (optional) Zielverzeichnis. Standard: <source>/public
;   • minify      (optional) true = Hugo mit --minify aufrufen.
;   • clean       (optional) true = --cleanDestinationDir. VORSICHT: entfernt
;                 im Ziel alles Nicht-Generierte — auch eine dort liegende
;                 Installation (edit/, cms-api/). Standard: false.
; install.sh trägt die Sektion bei der Einrichtung automatisch ein.
; ===========================================================================

[inhalte]
path = daten/inhalte
label = Inhalte
accept = md, markdown, html, htm, png, jpg, jpeg, gif, webp, svg

[vorlagen]
path = daten/vorlagen
label = Vorlagen
permissions = read, write

[medien]
path = daten/medien
label = Medien

;[hugo]
;source = /pfad/zum/hugo-projekt
;destination = /pfad/zum/hugo-projekt/public
;minify = true

; Reservierte Sektion [license] (KEIN Mount): Pro-Lizenz DIESER Webseite.
; Schaltet die Pro-Funktionen frei (derzeit die Git-Versionierung). Optional —
; ohne gültigen Schlüssel läuft die Community-Edition. Der Schlüssel ist an die
; DOMAIN dieser Webseite gebunden (starr, ohne Ablaufdatum, ohne Port/Endpunkt-
; Pfad) und wird über das Lizenzformular im Client eingetragen — dieser Eintrag
; wird dabei automatisch geschrieben. Da jede Webseite ihre eigene mounts/
; <hash>.ini hat, bekommt so jede Webseite ihre eigene Lizenz.
;   key   Lizenzschlüssel im Format HUGOCMS-...-...
;[license]
;key = "HUGOCMS-...-..."

; Reservierte Sektion [pagespeed] (KEIN Mount): Live-Adresse DIESER Webseite für
; den PageSpeed-Check (Pro). Wird über das PageSpeed-Panel eingegeben und beim
; Messstart automatisch geschrieben — ein manueller Eintrag ist nicht nötig. Der
; (globale) Google-API-Schlüssel steht dagegen zentral in der hugocms.ini
; ([services] pagespeed_key).
;   url   Öffentliche Adresse, die Google misst, z. B. https://example.com/
;[pagespeed]
;url = "https://example.com/"

; Reservierte Sektion [live_analysis] (KEIN Mount): Live-Adresse DIESER Webseite
; für die Live-Analyse (Pro, seo-success). Eigene Sektion, unabhängig von
; [pagespeed] — beide Prüfungen sind getrennt und optional. Wird über das
; Live-Analyse-Panel eingegeben und beim Start automatisch geschrieben — ein
; manueller Eintrag ist nicht nötig. Der Dienst-Schlüssel steht zentral in der
; hugocms.ini ([services] service_key).
;   url   Öffentliche Adresse, die der Dienst crawlt, z. B. https://example.com/
;[live_analysis]
;url = "https://example.com/"

; Reservierte Sektion [seo_report] (KEIN Mount): zusätzliche Ausschlüsse des
; SEO-Berichts (Pro) NUR für DIESE Webseite — für Verzeichnisse und Dateien, die
; es nur hier gibt. Die Ausschlüsse sind gestaffelt und ERGÄNZEN einander:
;   1. fest verdrahtet: die HugoCMS-Verzeichnisse (edit/, cms-api/, cms-admin/)
;      und die Papierkörbe der Mounts (.trash/)
;   2. global für alle Webseiten: [seo_report] der hugocms.ini
;   3. nur diese Webseite: diese Sektion
; Eine spätere Ebene kann nichts zurückholen, was eine frühere ausschließt.
; Schreibweise wie in der hugocms.ini: public-relativ, kommagetrennt; Präfixe mit
; Schrägstrich am Ende, Dateien als exakter Pfad ("..“ wird verworfen). Anders
; als [license] und [pagespeed] schreibt der Client diese Sektion NICHT — sie
; wird von Hand gepflegt. Das Konfigurationsformular bearbeitet ausschließlich
; die globale Sektion der hugocms.ini.
;[seo_report]
;exclude_prefixes = "kampagne/, landingpages/"
;exclude_files = "google37dc500bdbcbca59.html"

; Reservierte Sektion [improve] (KEIN Mount): Automatikmodus des Cron-
; Verbesserers (cron-improve.php) für DIESE Webseite. Ist auto = true, terminiert
; der Cron jeden erzeugten Entwurf gleich selbst — zu einem zufälligen Zeitpunkt
; im Tagesfenster, höchstens per_day Stück je Tag. So gehen verbesserte Seiten
; verteilt live statt alle auf einmal. Der Client pflegt diese Sektion über den
; Schalter in der Liste „zu verbessern“ und die Projekteinstellungen.
;   auto         true schaltet den Automatikmodus ein. Standard: aus.
;   window_start Beginn des Fensters, „HH:MM“ Serverzeit. Standard 07:00.
;   window_end   Ende des Fensters, „HH:MM“. Standard 16:00.
;   per_day       Höchstzahl Freigaben je Tag (1–50). Standard 3.
;   skip_weekends Samstag und Sonntag ausnehmen (Serverzeit). Standard: an —
;                 zum Terminieren auch am Wochenende ausdrücklich false setzen.
;[improve]
;auto = true
;window_start = "07:00"
;window_end = "16:00"
;per_day = 3
;skip_weekends = true

; Reservierte Sektion [cron] (KEIN Mount): Pausenschalter der drei Cron-Skripte
; DIESER Webseite. Ist ein Schalter true, prüft das zugehörige Skript das beim
; Start und tut nichts — so lässt sich ein Cron-Job aussetzen, ohne die Crontab
; des Hosters anzufassen. Der Client pflegt diese Sektion über die
; Kontrollkästchen im Systemstatus und die Projekteinstellungen.
;   pause_build       true pausiert cron-build.php. Standard: aus.
;   pause_improve     true pausiert cron-improve.php. Standard: aus.
;   pause_healthcheck true pausiert cron-healthcheck.php. Standard: aus.
;[cron]
;pause_build = false
;pause_improve = false
;pause_healthcheck = false

; Reservierte Sektion [git] (KEIN Mount): automatischer Commit beim Cron-Build
; (cron-build.php). Ist auto_commit an und das Quellverzeichnis ein
; Git-Repository, sichert der Cron VOR dem Build offene Änderungen (falls
; vorhanden) mit commit_message_pending und legt NACH dem Einspielen fälliger
; Freigaben einen Commit mit commit_message an; an beide Nachrichten wird das
; Datum (Serverzeit) angehängt. So bleibt der Veröffentlichungs-Commit auf die
; publizierten Dateien beschränkt. Setzt die Pro-Lizenz voraus (Git ist eine
; Pro-Funktion). Der Client pflegt diese Sektion über die Projekteinstellungen.
;   auto_commit            true schaltet beide Auto-Commits ein. Standard: aus.
;   commit_message         Nachricht nach der Veröffentlichung (ohne Datum). Leer = Vorgabe.
;   commit_message_pending Nachricht für offene Änderungen vor dem Build (ohne Datum). Leer = Vorgabe.
;
; changelog steht unabhängig von auto_commit: Es führt die Seite changelog.md im
; Content-Mount und schreibt sie bei JEDEM Versionsstand fort — beim Sichern von
; Hand, bei der Wiederherstellung und beim Auto-Commit des Cron. Da die Seite
; unter content/ liegt, wird sie von Hugo gebaut und ist öffentlich sichtbar;
; wer das nicht möchte, setzt in ihrem Front Matter draft: true oder
; headless: true — die Fortschreibung lässt beides unangetastet.
;   changelog              false schaltet das Änderungsprotokoll ab. Standard: AN.
;[git]
;auto_commit = true
;commit_message = "Automatische Veröffentlichung terminierter Freigaben"
;commit_message_pending = "Offene Änderungen vor dem Build gesichert"
;changelog = false
