; HugoCMS – Hauptkonfiguration
; ===========================================================================
; Wird dem Connector übergeben:
;
;     $connector = new Connector(['config' => __DIR__ . '/hugocms.ini']);
;
; Enthält Authentifizierung, Sitzungsverzeichnis und Logging. Die Mounts
; stehen separat in mounts.ini (siehe mounts.ini.beispiel).
; Relative Pfade gelten relativ zu DIESER Datei.
; ===========================================================================

[auth]
; Authentifizierungsverfahren. Eingebaut: singleuser.
; Weitere AuthInterface-Implementierungen lassen sich über die Connector-
; Option "authDrivers" registrieren (siehe index.php) und hier per driver
; auswählen.
driver = singleuser

; Felder für driver=singleuser:
; Anmeldename.
username = admin
; Passwort-HASH (NIEMALS das Klartextpasswort). Erzeugen mit:
;   php -r "echo password_hash('DEIN-PASSWORT', PASSWORD_DEFAULT), PHP_EOL;"
; Wegen der $-Zeichen in doppelte Anführungszeichen setzen.
password_hash = "HIER-PASSWORT-HASH-EINTRAGEN"

[user]
; Globale Einstellungen, die für alle Benutzer gelten. Solange
; driver=singleuser verwendet wird, ist diese Datei der einzige Speicherort
; für solche Einstellungen.
; session_lifetime: Sitzungsdauer in STUNDEN — so lange bleibt eine Anmeldung
; bei Inaktivität gültig; jede Aktion frischt das Fenster auf. Optional;
; fehlt der Wert, gilt der Standard von 8 Stunden.
;session_lifetime = 8
; content_width: Breite des zentrierten Hauptfensters in PIXELN auf großen
; Bildschirmen. Optional; fehlt der Wert, gilt der Standard 1200. Im
; Einzelbenutzer-Modus ist dies der Startwert nach jedem Neuladen (per Maus
; ziehbare Änderungen werden derzeit nicht gespeichert).
;content_width = 1200

[session]
; Verzeichnis für die PHP-Sitzungsdateien (muss für den Webserver-Benutzer
; beschreibbar sein). Pflichtfeld — darf nicht leer sein.
path = var/sessions

[log]
; Logdatei und Stufe: debug | info | warning | error
; Beide Felder sind Pflicht und dürfen nicht leer sein.
file = log/hugocms.log
level = warning

[hugo]
; Zentraler Pfad zum Hugo-PROGRAMM für den Veröffentlichen-Knopf (Befehl
; "build"). Installationsweit gibt es nur eine Hugo-Binärdatei, daher steht
; sie hier — nicht in den einzelnen Mount-Konfigurationen. Beziehen mit
; bin/get-hugo.sh. Relative Pfade gelten relativ zu DIESER Datei.
; Optional: Fehlt der Eintrag, wird der Veröffentlichen-Knopf nicht angeboten.
; Die je Webseite unterschiedlichen Pfade (source/destination) stehen in der
; [hugo]-Sektion der jeweiligen Mount-Konfiguration (siehe mounts.ini.beispiel).
bin = ../bin/hugo/hugo

;[ai]
; KI-Assistent (Claude). Optional — ohne API-Schlüssel ist der Assistent aus.
; Lässt sich auch über das Einrichtungs-/Konfigurationsformular setzen.
;   api_key    Anthropic API-Schlüssel (Geheimnis; Datei mit 0640 schützen).
;   model      Claude-Modell. Standard: claude-opus-4-8.
;   write_mode readonly = nur lesen | confirm = vor dem Schreiben bestätigen
;              | auto = Schreibaktionen direkt ausführen. Standard: confirm.
;api_key = "sk-ant-..."
;model = claude-opus-4-8
;write_mode = confirm

;[services]
; Externe Pro-Dienste (optional). Derzeit die Spracheingabe des KI-Assistenten
; über den Transkriptionsdienst (Projekt seo-success). Nur wirksam mit gültiger
; Pro-Lizenz. Der Schlüssel bleibt serverseitig und wird nie an den Client
; gegeben.
;   speech_key  API-Schlüssel des Dienstes (Geheimnis; Datei mit 0640 schützen).
;   speech_url  Voller Endpunkt, z. B. https://dein-dienst.example.com/v1/transcribe.
;speech_key = "seosk_live_..."
;speech_url = "https://dein-dienst.example.com/v1/transcribe"

; Hinweis: Die Pro-Lizenz steht NICHT hier, sondern PRO WEBSEITE in der
; jeweiligen Mount-Konfiguration (mounts/<hash>.ini, [license]-Sektion) —
; HugoCMS verwaltet mehrere Webseiten, jede mit eigener, domain-gebundener
; Lizenz. Siehe mounts.ini.beispiel.
