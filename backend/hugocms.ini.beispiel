; HugoCMS – Hauptkonfiguration
; ===========================================================================
; Wird dem Connector übergeben:
;
;     $connector = new Connector(['config' => __DIR__ . '/hugocms.ini']);
;
; Enthält Authentifizierung, Sitzungsverzeichnis und Logging. Die Mounts
; stehen separat in mounts.ini (siehe mounts.ini.beispiel).
; Relative Pfade gelten relativ zu DIESER Datei.
; ===========================================================================

[auth]
; Authentifizierungsverfahren. Eingebaut: singleuser, multiuser.
; Weitere AuthInterface-Implementierungen lassen sich über die Connector-
; Option "authDrivers" registrieren (siehe index.php) und hier per driver
; auswählen.
driver = singleuser

; Felder für driver=singleuser:
; Anmeldename.
username = admin
; Passwort-HASH (NIEMALS das Klartextpasswort). Erzeugen mit:
;   php -r "echo password_hash('DEIN-PASSWORT', PASSWORD_DEFAULT), PHP_EOL;"
; Wegen der $-Zeichen in doppelte Anführungszeichen setzen.
password_hash = "HIER-PASSWORT-HASH-EINTRAGEN"

; --- driver=multiuser (mehrere Konten, PRO-FUNKTION) -----------------------
; Umstellen genügt: driver = multiuser. Gibt es noch kein Konto, wird der
; obige Einzelbenutzer beim nächsten Aufruf zum ersten Administrator — mit
; unverändertem Passwort. Danach werden weitere Konten in der Oberfläche
; angelegt („Benutzer verwalten", nur für Administratoren sichtbar).
;
; Jedes Konto liegt als eigene INI-Datei unter users/ (Dateiname = SHA-256 des
; kleingeschriebenen Anmeldenamens), analog zu mounts/<hash>.ini. Es gibt genau
; zwei Rollen:
;   admin   erreicht alle Webseiten, verwaltet Konten und setzt fremde
;           Passwörter neu.
;   editor  arbeitet an den zugewiesenen Webseiten (Feld `sites` der
;           Kontodatei; "*" = alle) und verwaltet keine Konten.
; Was auf einem Mount erlaubt ist, entscheidet unverändert ALLEIN dessen
; Mount-Konfiguration (permissions/readonly) — die Rolle regelt nur, WELCHE
; Webseiten sichtbar sind.
;
; Pro-Schranke: Ohne gültige Pro-Lizenz für die aufgerufene Webseite melden
; sich nur Administratoren an. So sperrt eine fehlende oder abgelaufene Lizenz
; niemanden endgültig aus — der Administrator kommt herein und kann sie
; eintragen —, die übrigen Konten bleiben so lange draußen.
;
; Optional: anderes Verzeichnis für die Kontodateien (relativ zu DIESER Datei).
;users_dir = users

[user]
; Globale Einstellungen, die für alle Benutzer gelten. Solange
; driver=singleuser verwendet wird, ist diese Datei der einzige Speicherort
; für solche Einstellungen.
; session_lifetime: Sitzungsdauer in STUNDEN — so lange bleibt eine Anmeldung
; bei Inaktivität gültig; jede Aktion frischt das Fenster auf. Optional;
; fehlt der Wert, gilt der Standard von 8 Stunden. Lässt sich auch im Dialog
; „Konto und Einstellungen" setzen (dort 0,25 bis 720 Stunden).
;session_lifetime = 8
; content_width: Breite des zentrierten Hauptfensters in PIXELN auf großen
; Bildschirmen. Optional; fehlt der Wert, gilt der Standard 1200. Im
; Einzelbenutzer-Modus schreibt die Oberfläche eine per Greifrand gezogene
; Breite selbst hierher — nach dem Neuladen gilt wieder der zuletzt
; eingestellte Wert. Doppelklick auf einen Greifrand setzt auf 1200 zurück.
;content_width = 1200
; toolbar_collapsed: ob die vertikale Werkzeugleiste auf Desktop-Breite
; eingeklappt (nur Symbole) startet. Optional; fehlt der Wert, startet sie
; ausgeklappt. Im Einzelbenutzer-Modus merkt die Oberfläche das Umschalten
; selbst hierher; auf schmalen Schirmen bleibt der Umschalter ohne Wirkung auf
; diesen Wert.
;toolbar_collapsed = false
; update_lastmod: legt fest, ob beim Speichern ein vorhandenes Front-Matter-Feld
; „lastmod“ auf die aktuelle Zeit gesetzt wird. Fehlt der Schlüssel, fragt der
; Editor beim Speichern nach (mit Option, die Wahl hier dauerhaft zu merken).
; true = immer aktualisieren, false = nie. Lässt sich auch im Dialog „Konto und
; Einstellungen" setzen — dort stellt „Jedes Mal nachfragen“ den Schlüssel
; wieder ab.
;update_lastmod = false

[session]
; Verzeichnis für die PHP-Sitzungsdateien (muss für den Webserver-Benutzer
; beschreibbar sein). Pflichtfeld — darf nicht leer sein.
;
; Abgelaufene Dateien räumt HugoCMS selbst weg (Auth\SessionCleaner): PHPs
; eigene Müllabfuhr greift in einem eigenen Verzeichnis nicht — auf Debian und
; Ubuntu steht session.gc_probability auf 0, und der System-Cron kennt nur den
; Standardpfad. Gelöscht wird anhand des Verfallszeitpunkts IN der Sitzung, die
; Sitzungsdauer je Konto bleibt also gewahrt.
path = var/sessions

[log]
; Logdatei und Stufe: debug | info | warning | error
; Beide Felder sind Pflicht und dürfen nicht leer sein.
file = log/hugocms.log
level = warning
; Größenbasierte Rotation ohne externe Werkzeuge (kein logrotate/Cron nötig):
; Erreicht die Datei max_bytes, wird sie durchrotiert (hugocms.log -> .1 -> .2
; … bis .keep, ältester Stand fällt weg). Plattenverbrauch ~ max_bytes * (keep+1).
; Beide Felder optional; leer/fehlend gilt der Standard. max_bytes = 0 schaltet
; die Rotation ab.
max_bytes = 1048576
keep = 3

[hugo]
; Zentraler Pfad zum Hugo-PROGRAMM für den Veröffentlichen-Knopf (Befehl
; "build"). Installationsweit gibt es nur eine Hugo-Binärdatei, daher steht
; sie hier — nicht in den einzelnen Mount-Konfigurationen. Beziehen mit
; bin/get-hugo.sh. Relative Pfade gelten relativ zu DIESER Datei.
; Optional: Fehlt der Eintrag, wird der Veröffentlichen-Knopf nicht angeboten.
; Die je Webseite unterschiedlichen Pfade (source/destination) stehen in der
; [hugo]-Sektion der jeweiligen Mount-Konfiguration (siehe mounts.ini.beispiel).
bin = ../bin/hugo/hugo
; Optional: clean = true übergibt Hugo --cleanDestinationDir und leert vor jedem
; Build das Zielverzeichnis von allem, was Hugo nicht selbst erzeugt. VORSICHT,
; wenn im Zielordner weitere Dateien liegen. Standard: aus. Über den Dialog
; „Konfiguration ändern" schaltbar.
;clean = true

;[ai]
; KI-Assistent (Claude). Optional — ohne API-Schlüssel ist der Assistent aus.
; Lässt sich auch über das Einrichtungs-/Konfigurationsformular setzen.
;   api_key     Anthropic API-Schlüssel (Geheimnis; Datei mit 0640 schützen).
;   model       Claude-Modell des interaktiven Assistenten. Standard:
;               claude-opus-5. Dient zugleich als Rückfall für die beiden
;               folgenden Modelle.
;   model_cron  Modell des CLI-/Cron-Verbesserers (cron-improve.php). Optional;
;               ohne Angabe wie `model`.
;   model_audit Modell der Content-Qualitätsprüfung. Optional; ohne Angabe wie
;               `model`.
;   models      Auswahlliste der Modell-Felder in der Oberfläche, kommagetrennt.
;               Optional; ohne Angabe gilt die mitgelieferte Liste. Der
;               Aktualisieren-Knopf neben „KI-Assistent" im Konfigurations-
;               dialog holt die aktuelle Liste von der API und schreibt sie
;               hierher — ohne Datums-Suffix und ohne veraltete Modelle
;               (Auswahl siehe AnthropicClient::HIDDEN_MODELS). Wer ein
;               ausgefiltertes Modell braucht, trägt es hier von Hand ein;
;               der Assistent nutzt jede gültige Modell-ID.
;   write_mode  readonly = nur lesen | confirm = vor dem Schreiben bestätigen
;               | auto = Schreibaktionen direkt ausführen. Standard: confirm.
;api_key = "sk-ant-..."
;model = claude-opus-5
;models = claude-opus-5,claude-fable-5-1,claude-fable-5,claude-opus-4-8,claude-sonnet-5,claude-haiku-4-5
;model_cron = claude-sonnet-5
;model_audit = claude-haiku-4-5
;write_mode = confirm

;[seo_report]
; SEO-Bericht (Pro-Funktion). Der Audit durchläuft den gebauten public/-Ordner
; und prüft JEDE gefundene HTML-Datei — unabhängig davon, ob darauf verlinkt
; wird. Die HugoCMS-eigenen Verzeichnisse (edit/, cms-api/, cms-admin/) sowie
; die Papierkörbe der Mounts (.trash/, in jeder Tiefe) sind fest verdrahtet
; ausgeschlossen. Über exclude_prefixes lassen sich WEITERE
; public-relative Pfad-Präfixe ergänzen, die nicht in den Bericht sollen (z. B.
; Test- oder Fehlerseiten). Kommagetrennt; ein Präfix pro Verzeichnis, mit
; Schrägstrich am Ende (führende Schrägstriche und ".." werden entfernt).
; Optional; fehlt die Sektion, gelten nur die fest verdrahteten Ausschlüsse.
; Lässt sich auch über das Konfigurationsformular setzen.
;exclude_prefixes = "test/, error/, entwurf/"
; Über exclude_files lassen sich EINZELNE Dateien ausschließen (exakter public-
; relativer Pfad statt Verzeichnis-Präfix) — etwa Suchmaschinen-Bestätigungs-
; dateien, die nicht verändert oder gelöscht werden dürfen. Kommagetrennt.
;exclude_files = "google37dc500bdbcbca59.html, BingSiteAuth.xml"
; Diese Sektion gilt GLOBAL für alle Webseiten. Was nur EINE Webseite betrifft,
; gehört in die gleichnamige Sektion ihrer Mount-Konfiguration (mounts/
; <hash>.ini, siehe mounts.ini.beispiel); beide Listen ergänzen einander.

;[services]
; Externe Pro-Dienste (optional). Der seo-success-Dienst deckt mit EINEM
; Schlüssel (ein gemeinsames Kontingent) die Spracheingabe des KI-Assistenten
; UND die Live-Analyse ab. Nur wirksam mit gültiger Pro-Lizenz. Der Schlüssel
; bleibt serverseitig und wird nie an den Client gegeben.
;   service_key  API-Schlüssel des Dienstes (Geheimnis; Datei mit 0640 schützen).
;   service_url  Basis-Adresse des Dienstes (die Endpunkte /v1/transcribe,
;                /v1/analyze … werden automatisch angehängt).
;                Standard: https://api.hugocms.com/
; Rückfall: Die früheren Namen speech_key/speech_url werden weiterhin gelesen,
; falls noch gesetzt — bestehende Installationen laufen unverändert weiter. Beim
; nächsten Speichern über das Konfigurationsformular werden sie auf service_*
; umgeschrieben.
; Ebenfalls hier: der (globale) Google-API-Schlüssel für den PageSpeed-Check.
; Nur wirksam mit gültiger Pro-Lizenz. Der Schlüssel bleibt serverseitig.
;   pagespeed_key  Google-API-Schlüssel (OPTIONAL). Ohne Schlüssel gilt ein
;                  kleines Kontingent; mit kostenlosem Schlüssel aus der Google
;                  Cloud Console deutlich mehr (25.000 Anfragen/Tag).
; Die zu messende Live-Adresse steht PRO WEBSEITE in der Mount-Konfiguration
; ([pagespeed] url) und wird im PageSpeed-Panel gesetzt — nicht hier.
; Lässt sich auch über das Konfigurationsformular setzen.
;service_key = "seosk_live_..."
;service_url = "https://api.hugocms.com/"
;pagespeed_key = "AIza..."

;[mail]
; E-Mail-Versand für den Gesundheitscheck-Cron (cron-healthcheck.php). Der
; Versand läuft über einen eigenen, schlanken SMTP-Client — kein externer
; Dienst nötig. Wird nur gebraucht, wenn der Gesundheitscheck bei Fehlern oder
; Warnungen benachrichtigen soll. Diese Sektion ist NICHT [user].
; Damit der Versand aktiv ist, müssen mindestens smtp_host, from und to gesetzt
; sein. Die Datei mit 0640 schützen — smtp_pass ist ein Geheimnis.
;   smtp_host      SMTP-Server.
;   smtp_port      Port. Standard: 587 (STARTTLS) bzw. 465 (bei security=ssl).
;   smtp_security  tls = STARTTLS | ssl = implizites SSL | none = unverschlüsselt.
;                  Standard: tls.
;   smtp_user      Login. Leer = keine Authentifizierung (offenes Relay).
;   smtp_pass      Passwort (Geheimnis).
;   from           Absenderadresse (optional mit Name: "HugoCMS <cms@example.com>").
;   to             Empfängeradresse für die Benachrichtigungen.
;smtp_host = "smtp.example.com"
;smtp_port = 587
;smtp_security = tls
;smtp_user = "cms@example.com"
;smtp_pass = "GEHEIM"
;from = "HugoCMS <cms@example.com>"
;to = "admin@example.com"

; Hinweis: Die Pro-Lizenz steht NICHT hier, sondern PRO WEBSEITE in der
; jeweiligen Mount-Konfiguration (mounts/<hash>.ini, [license]-Sektion) —
; HugoCMS verwaltet mehrere Webseiten, jede mit eigener, domain-gebundener
; Lizenz. Siehe mounts.ini.beispiel.
