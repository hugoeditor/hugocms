<?php
/**
 * custom.php – anwenderspezifischer Bootstrap (optional).
 *
 * Wird von backend/core/hugocms.php automatisch eingebunden, FALLS die Datei
 * backend/custom/custom.php existiert, und übernimmt dann die komplette
 * Konfiguration: Connector instanzieren, Mounts festlegen, run() aufrufen.
 * Der Autoloader ist bereits geladen.
 *
 * Dies ist die flexible Alternative zu den INI-Dateien — z. B. für eigene
 * AuthInterface-Implementierungen oder dynamisch ermittelte Mounts.
 *
 * Zum Verwenden: in diesem Verzeichnis nach custom.php kopieren und anpassen.
 */

declare(strict_types=1);

use HugoCMS\FileManager\Connector;
use HugoCMS\FileManager\Auth\SingleUser;

// Diese Datei liegt in backend/custom/. Verzeichnisse darüber:
$backendDir = dirname(__DIR__);     // backend/  (hier liegen hugocms.ini, log/, var/)
$appRoot    = dirname($backendDir); // Anwendungswurzel (neben app/)

// --- Empfohlen: Infrastruktur aus hugocms.ini, Mounts hier programmatisch ---
// So kommen Session-Verzeichnis, Logging und Anmeldung weiterhin aus der
// gut lesbaren hugocms.ini, während die Mounts dynamisch entstehen können.
$connector = new Connector(['config' => $backendDir . '/hugocms.ini']);

$connector->mount('inhalte', $appRoot . '/daten/inhalte', [
    'label' => 'Inhalte',
    'accept' => ['md', 'markdown', 'html', 'htm', 'png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'],
]);
$connector->mount('vorlagen', $appRoot . '/daten/vorlagen', [
    'label' => 'Vorlagen',
    'permissions' => ['read', 'write'],
]);
$connector->mount('medien', $appRoot . '/daten/medien', [
    'label' => 'Medien',
]);

$connector->run();

// --- Alternative: vollständig programmatisch (ohne hugocms.ini) ---
// Dann das Sitzungsverzeichnis selbst setzen (vor dem ersten session_start):
//
//     $sessionPath = $backendDir . '/var/sessions';
//     if (is_dir($sessionPath)) { session_save_path($sessionPath); }
